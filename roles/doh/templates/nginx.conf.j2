user www-data;
worker_processes auto;
worker_cpu_affinity auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;

include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log /var/log/nginx/access.log;

    gzip on;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}

stream {
    resolver 1.1.1.1 8.8.8.8 ipv6=off valid=300s;
    resolver_timeout 5s;

    map $ssl_preread_server_name $backend_pool {
        hostnames;
        {{ doh_domain }}        127.0.0.1:8443;
        *.{{ doh_zone }}        127.0.0.1:8443;
        {{ doh_zone }}          127.0.0.1:8443;
        ~^$                     127.0.0.1:8443;
        default                 127.0.0.1:10444;
    }

    server {
        listen 443;
        listen [::]:443;
        proxy_pass $backend_pool;

        # Keep the real client IP for the HTTP vhosts (real_ip_header proxy_protocol).
        proxy_protocol on;

        ssl_preread on;
        preread_buffer_size 16k;
        preread_timeout 10s;

        proxy_timeout 3600s;
        proxy_connect_timeout 10s;
        proxy_buffer_size 16k;
        proxy_socket_keepalive on;
    }

    # External fallback: accept PROXY from the 443 gateway, then forward
    # the original TLS stream to the requested host without PROXY.
    server {
        listen 127.0.0.1:10444 proxy_protocol;
        proxy_pass $ssl_preread_server_name:443;

        ssl_preread on;

        proxy_timeout 3600s;
        proxy_connect_timeout 10s;
        proxy_buffer_size 16k;
        proxy_socket_keepalive on;
    }
}
